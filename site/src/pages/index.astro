---
// The landing page. Everything on it is read from the repository at build time
// (marketplace.json, manifest.json, catalog.json, the plugin folders and the guides),
// so it stays in step with what is actually installable.
import fs from "node:fs";
import path from "node:path";
import { getCollection } from "astro:content";
import marketplace from "../../../.claude-plugin/marketplace.json";
import manifest from "../../../manifest.json";
import catalog from "../../../catalog.json";
import AskAI from "../components/AskAI.astro";
// Fonts are served from this site (Latin subset only), so pages make no third-party requests.
import "@fontsource/schibsted-grotesk/latin-400.css";
import "@fontsource/schibsted-grotesk/latin-500.css";
import "@fontsource/schibsted-grotesk/latin-600.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import bodyFont from "@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-400-normal.woff2?url";

const ROOT = path.resolve(process.cwd(), "..");
const MARKETPLACE = marketplace.name;
// Plugins referenced from other repositories aren't on disk here, so catalog.json gives their skill count and credit.
const referenced = catalog.referenced as Record<string, { skills: number; credit: string }>;
const optIn = new Set(["ponytail", "observer"]);

const skillsIn = (plugin: string) => {
  const dir = path.join(ROOT, "plugins", plugin, "skills");
  return fs.existsSync(dir) ? fs.readdirSync(dir) : [];
};

// Short, plain descriptions: the first sentence of each plugin's own description.
const firstSentence = (text: string) => {
  const sentence = text.replace(/^Opt-in: /, "").split(/(?<=\.)\s/)[0];
  return sentence.charAt(0).toUpperCase() + sentence.slice(1);
};

const authorsOf = (plugin: string) => {
  const names = new Set<string>();
  for (const [skill, entry] of Object.entries(manifest.skills)) {
    if (entry.plugin === plugin) names.add(manifest.sources[entry.source as keyof typeof manifest.sources].author);
  }
  for (const skill of skillsIn(plugin)) if (!(skill in manifest.skills)) names.add("Iatee");
  return [...names];
};

const plugins = marketplace.plugins
  .filter((p) => p.name !== "all")
  .map((p) => {
    const local = typeof p.source === "string";
    const json = local
      ? JSON.parse(fs.readFileSync(path.join(ROOT, p.source as string, ".claude-plugin", "plugin.json"), "utf8"))
      : {};
    const ref = referenced[p.name];
    return {
      name: p.name,
      description: firstSentence(p.description ?? json.description ?? ""),
      skills: local ? skillsIn(p.name).length : ref?.skills ?? 0,
      authors: local ? authorsOf(p.name) : [ref?.credit.replace(/^\[([^\]]+)\].*$/, "$1") ?? ""],
      optIn: optIn.has(p.name),
    };
  })
  .sort((a, b) => Number(a.optIn) - Number(b.optIn));

const totalSkills = Object.keys(catalog.skills).length + Object.values(referenced).reduce((n, r) => n + r.skills, 0);

const credits = [
  ...new Map(Object.values(manifest.sources).map((s) => [s.author, `https://github.com/${s.repo}`])),
  ...Object.values(referenced).map((r) => r.credit.match(/^\[([^\]]+)\]\(([^)]+)\)$/)!.slice(1, 3)),
];

const docs = await getCollection("docs");
const guide = (id: string) => docs.find((d) => d.id === id)!;
const guideGroups = [
  { label: "Get started", ids: ["start-here", "using-skills", "catalog"] },
  { label: "Go further", ids: ["power-user", "customize", "own-server"] },
];

const description =
  "A curated set of Claude Code skills, each credited to its author, with a suggester that points out the right one while you work.";
const pageUrl = new URL("/", Astro.site).href;
// The skill count comes from the catalog, so the title stays right as skills are added.
const title = `Claude Skills - ${totalSkills} curated skills for Claude Code`;

// Structured data for search engines and AI assistants: the site and its installable plugins.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "Claude Skills",
      url: pageUrl,
      description,
      inLanguage: "en",
    },
    {
      "@type": "ItemList",
      name: "Claude Skills plugins",
      itemListElement: plugins.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
          "@type": "SoftwareApplication",
          name: p.name,
          description: p.description,
          applicationCategory: "DeveloperApplication",
          operatingSystem: "Claude Code",
          // Companies and groups are organizations; everyone else credited is a person.
          author: p.authors.map((name) => ({ "@type": /Microsoft|Contributors|\.com/.test(name) ? "Organization" : "Person", name })),
          installUrl: "https://github.com/iatee/claude-skills",
        },
      })),
    },
  ],
};

const install = [
  `/plugin marketplace add iatee/claude-skills`,
  `/plugin install all@${MARKETPLACE}`,
  `/reload-plugins`,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Claude Skills" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="en" />
    <meta property="og:image" content={new URL("/og.png", Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Claude Skills: curated skills for Claude Code, with an example suggester line." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og.png", Astro.site).href} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Follow the light or dark choice made in the guides, which Starlight keeps; otherwise follow the system.
      try {
        const theme = localStorage.getItem("starlight-theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <p class="sr-only" role="status" id="copy-status"></p>

    <header class="topbar">
      <div class="wrap topbar-inner">
        <a class="brand" href="/" aria-label="Claude Skills, home">
          <svg class="logo" viewBox="0 0 32 32" width="22" height="22" aria-hidden="true"><rect class="logo-tile" width="32" height="32" rx="7"/><rect x="9" y="7" width="14" height="18" rx="2.5"/><path d="M13 12.5h6M13 16h6M13 19.5h3.5"/></svg>
          Claude Skills
        </a>
        <nav aria-label="Main">
          <a href="/start-here/">Guides</a>
          <a href="/catalog/">Catalog</a>
          <a class="icon-link" href="https://github.com/iatee/claude-skills" aria-label="GitHub repository">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero wrap">
        <div class="hero-copy">
          <h1>Curated skills for <em>Claude&nbsp;Code</em></h1>
          <p class="lede">
            {totalSkills} hand-picked skills, each credited to its author, with a suggester that points out
            the right one while you work.
          </p>

          <div class="install" role="group" aria-labelledby="install-label">
            <div class="install-head">
              <span id="install-label">Run in Claude Code</span>
              <button type="button" class="copy" data-copy={install.join("\n")}>
                <svg class="i-copy" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
                <svg class="i-check" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="m5 12 5 5 9-10"/></svg>
                <span class="copy-label">Copy</span>
              </button>
            </div>
            <ol class="commands">
              {install.map((line) => <li><code>{line.split(" ").map((word, i) => <>{i > 0 && " "}<span>{word}</span></>)}</code></li>)}
            </ol>
          </div>

          <p class="hero-links">
            New to Claude Code? <a href="/start-here/">Start with the setup guide</a>
            <span aria-hidden="true">·</span>
            <a href="/catalog/">Browse the catalog</a>
          </p>

          <div class="hero-ask">
            <AskAI
              url="https://skills.garciabaertsch.com/"
              prompt="Summarize what this Claude Code skill collection offers and whether it is useful for me:"
            />
          </div>
        </div>

        <figure class="exchange" aria-label="Example: the suggester in a Claude Code session">
          <figcaption>Claude Code</figcaption>
          <div class="msg user">
            <span class="who">You</span>
            <p>I want to start a newsletter about home gardening. Can you help me plan it?</p>
          </div>
          <div class="msg claude">
            <span class="who">Claude</span>
            <p>
              Happy to. Start with who it's for and how often it goes out: those two choices shape everything
              else, from the topics to the length of each issue.
            </p>
            <p class="suggestion">
              💡 <code>/planning:grill-me</code> could help here: it interviews you about the plan until there are no
              gaps.
            </p>
          </div>
          <p class="exchange-note">
            When an installed skill clearly fits, the suggester tells Claude. For a skill only you can start,
            Claude adds one line like this; otherwise it stays silent. Turn it off with <code>/suggester off</code>.
          </p>
        </figure>
      </section>

      <section class="section wrap" aria-labelledby="plugins-title">
        <div class="section-head">
          <h2 id="plugins-title">Plugins</h2>
          <p>
            <code>all</code> installs everything except the opt-in plugins. To pick and choose, install single plugins
            with the command beside each one.
          </p>
        </div>
        <ul class="plugins">
          {plugins.map((p) => (
            <li class:list={["plugin", { "is-optin": p.optIn }]}>
              <div class="plugin-main">
                <h3>
                  <code>{p.name}</code>
                  {p.optIn && <span class="badge">Opt-in</span>}
                </h3>
                <p>{p.description}</p>
                <p class="meta">
                  {p.skills} {p.skills === 1 ? "skill" : "skills"} · {p.authors.join(", ")}
                </p>
              </div>
              <button type="button" class="plugin-cmd" data-copy={`/plugin install ${p.name}@${MARKETPLACE}`} data-copy-name={p.name} aria-label={`Copy install command for ${p.name}`}>
                <code>/plugin install {p.name}@{MARKETPLACE}</code>
                <svg class="i-copy" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
                <svg class="i-check" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="m5 12 5 5 9-10"/></svg>
              </button>
            </li>
          ))}
        </ul>
      </section>

      <section class="section wrap" aria-labelledby="guides-title">
        <div class="section-head">
          <h2 id="guides-title">Guides</h2>
          <p>From a first session to running Claude Code on a server of your own.</p>
        </div>
        <div class="guide-groups">
          {guideGroups.map((group) => (
            <div>
              <h3 class="group-label">{group.label}</h3>
              <ul class="guides">
                {group.ids.map((id) => (
                  <li>
                    <a href={`/${id}/`}>
                      <span class="guide-title">
                        {guide(id).data.title}
                        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                      </span>
                      <span class="guide-desc">{guide(id).data.description}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section class="section wrap credits" aria-labelledby="credits-title">
        <h2 id="credits-title">Credits</h2>
        <p>
          Most skills here were written by other people and are redistributed under their open-source licenses. Each
          keeps its license file, and changes are listed in the{" "}
          <a href="https://github.com/iatee/claude-skills/blob/main/THIRD_PARTY_NOTICES.md">third-party notices</a>.
        </p>
        <ul>
          {credits.map(([name, url]) => <li><a href={url}>{name}</a></li>)}
        </ul>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <p>An unofficial, personal collection. Not affiliated with or endorsed by Anthropic.</p>
        <p><a href="/privacy/">Privacy</a> · <a href="https://github.com/iatee/claude-skills">github.com/iatee/claude-skills</a></p>
      </div>
    </footer>

    <script>
      import "../easter-eggs";

      // Copy buttons confirm in place and to screen readers. Where the browser won't allow copying,
      // the commands are selected instead, with the key to press.
      const status = document.getElementById("copy-status")!;
      const copyKey = /Mac|iPhone|iPad/.test(navigator.userAgent) ? "⌘C" : "Ctrl+C";
      const announce = (text: string) => {
        status.textContent = "";
        setTimeout(() => (status.textContent = text), 50);
      };
      for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
        const label = button.querySelector(".copy-label");
        const what = button.dataset.copyName ? `The install command for ${button.dataset.copyName}` : "The install commands";
        let reset = 0;
        const show = (text: string, copied: boolean) => {
          clearTimeout(reset);
          if (copied) button.dataset.copied = "";
          if (label) label.textContent = text;
          reset = window.setTimeout(() => {
            delete button.dataset.copied;
            if (label) label.textContent = "Copy";
          }, copied ? 1600 : 4000);
        };
        button.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? "");
          } catch {
            const target = button.closest(".install")?.querySelector(".commands") ?? button.querySelector("code");
            if (target) getSelection()?.selectAllChildren(target);
            show(`Press ${copyKey}`, false);
            announce(`Copying isn't available here. ${what} ${button.dataset.copyName ? "is" : "are"} selected; press ${copyKey} to copy.`);
            return;
          }
          show("Copied", true);
          announce(`${what} ${button.dataset.copyName ? "was" : "were"} copied.`);
        });
      }

      // A click anywhere on the install panel's commands copies them, unless it ends a text selection.
      document.querySelector(".commands")?.addEventListener("click", () => {
        if (!getSelection()?.toString()) document.querySelector<HTMLButtonElement>(".install .copy")?.click();
      });

      // The example plays once when it comes into view: the suggester's line arrives after Claude's reply.
      // Without this script the line is simply there.
      const suggestion = document.querySelector<HTMLElement>(".suggestion");
      if (suggestion && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver((entries) => {
          if (!entries[0].isIntersecting) return;
          suggestion.dataset.play = "";
          observer.disconnect();
        });
        observer.observe(suggestion);
      }
    </script>
  </body>
</html>

<style is:global>
  /* Each token holds its light and dark value. The page follows the system, or the light or dark
     choice made in the guides (see the script in <head>). */
  :root {
    --bg: light-dark(#fafafa, #0a0a0a);
    --surface: light-dark(#ffffff, #121212);
    --subtle: light-dark(#f2f2f2, #1a1a1a);
    --text: light-dark(#161616, #ededed);
    --text-2: light-dark(#4f4f4f, #a3a3a3);
    --text-3: light-dark(#6a6a6a, #8a8a8a);
    --line: light-dark(#e3e3e3, #242424);
    --line-strong: light-dark(#cfcfcf, #333333);
    /* Magenta is the site's own colour: the mark, action and emphasis. Amber stays the suggester's. */
    --accent: light-dark(#b8145f, #ff5cad);
    --accent-hover: light-dark(#8f0f4a, #ffa3cf);
    --on-accent: light-dark(#ffffff, #0a0a0a);
    --accent-soft: light-dark(#fbe7f0, #2a0f1d);
    /* Hint: the suggester's own colour. */
    --hint-ink: light-dark(#8a4b08, #f0bf63);
    --hint-soft: light-dark(#fdf7e8, #1e1910);
    --hint-line: light-dark(#e6c983, #4a3a1a);
    --success: light-dark(#15803d, #4ade80);
    --on-success: light-dark(#ffffff, #0a0a0a);
    --code-bg: light-dark(#f2f2f2, #1a1a1a);
    --shadow: 0 1px 2px light-dark(rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.4)), 0 6px 20px -6px light-dark(rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.6));
    --radius: 8px;
    color-scheme: light dark;
  }
  :root[data-theme="light"] { color-scheme: light; }
  :root[data-theme="dark"] { color-scheme: dark; }

  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-padding-top: 72px; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 400 16px/1.6 "Schibsted Grotesk", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
    font-feature-settings: "ss01";
  }
  ::selection { background: var(--accent-soft); color: var(--text); }
  /* Links are ink, told apart by a magenta underline that thickens on hover. */
  a {
    color: var(--text);
    text-decoration: underline 1px var(--accent);
    text-underline-offset: 3px;
    transition: text-decoration-thickness 0.15s;
  }
  a:hover { text-decoration-thickness: 2px; }
  code { font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.875em; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  svg path, svg rect { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  .wrap { width: min(1080px, 100% - 32px); margin-inline: auto; }
  .skip { position: absolute; left: -9999px; }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .skip:focus { left: 16px; top: 12px; z-index: 10; padding: 8px 12px; background: var(--surface); border-radius: var(--radius); }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 5;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
  }
  .topbar-inner { display: flex; align-items: center; justify-content: space-between; height: 56px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--text); font-weight: 600; font-size: 15px; }
  .brand { text-decoration: none; }
  /* The mark is drawn inline so it follows the page's light or dark choice: a magenta tile, a ground-coloured page. */
  .logo { color: var(--on-accent); }
  .logo .logo-tile { fill: var(--accent); stroke: none; }
  .topbar nav { display: flex; align-items: center; gap: 22px; font-size: 14px; }
  .topbar nav a { color: var(--text-2); text-decoration: none; transition: color 0.15s; }
  .topbar nav a:hover { color: var(--text); }
  .icon-link { display: inline-flex; text-decoration: none; }
  .icon-link svg path { fill: currentColor; stroke: none; }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
    padding: 88px 0 96px;
  }
  h1 {
    margin: 0;
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  h1 em { color: var(--accent); font-style: normal; }
  .lede { margin: 20px 0 0; max-width: 34em; color: var(--text-2); font-size: 18px; line-height: 1.55; }

  .install {
    margin-top: 32px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: var(--shadow);
    transition: border-color 0.15s;
  }
  /* The whole panel copies on click, not only its button. */
  .install:hover { border-color: var(--line-strong); }
  .commands { cursor: copy; }
  .install-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 8px 8px 16px;
    border-bottom: 1px solid var(--line);
    color: var(--text-3);
    font-size: 13px;
  }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 12px;
    border: 0;
    border-radius: 6px;
    background: var(--accent);
    color: var(--on-accent);
    font: 500 13px/1 inherit;
    font-family: inherit;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  .copy:hover { background: var(--accent-hover); }
  .copy[data-copied], .copy[data-copied]:hover { background: var(--success); color: var(--on-success); }
  .i-check { display: none; }
  [data-copied] .i-copy { display: none; }
  [data-copied] .i-check { display: inline; animation: check-in 0.22s cubic-bezier(0.16, 1, 0.3, 1); }
  @keyframes check-in { from { opacity: 0; transform: scale(0.5); } }
  .commands { margin: 0; padding: 14px 16px; list-style: none; }
  /* The prompt hangs, so a command that wraps on a phone stays readable in full. */
  .commands li { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: baseline; column-gap: 10px; padding: 3px 0; line-height: 1.6; }
  .commands li::before { content: "›"; color: var(--accent); font-family: "JetBrains Mono", monospace; }
