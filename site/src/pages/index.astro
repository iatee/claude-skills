---
// The landing page. Everything on it is read from the repository at build time
// (marketplace.json, manifest.json, catalog.json, the plugin folders and the guides),
// so it stays in step with what's actually installable.
import fs from "node:fs";
import path from "node:path";
import { getCollection } from "astro:content";
import marketplace from "../../../.claude-plugin/marketplace.json";
import manifest from "../../../manifest.json";
import catalog from "../../../catalog.json";

const ROOT = path.resolve(process.cwd(), "..");
const skillCount = (plugin: string) => {
  const dir = path.join(ROOT, "plugins", plugin, "skills");
  return fs.existsSync(dir) ? fs.readdirSync(dir).length : 0;
};
const referencedCounts: Record<string, number> = { "taste-skill": 14, ponytail: 6 };
const optIn = new Set(["ponytail", "observer"]);

const plugins = marketplace.plugins
  .filter((p) => p.name !== "all")
  .map((p) => {
    const local = typeof p.source === "string";
    const json = local
      ? JSON.parse(fs.readFileSync(path.join(ROOT, p.source, ".claude-plugin", "plugin.json"), "utf8"))
      : {};
    return {
      name: p.name,
      description: (p.description ?? json.description ?? "").replace(/^Opt-in: /, ""),
      skills: local ? skillCount(p.name) : referencedCounts[p.name] ?? 0,
      optIn: optIn.has(p.name),
      external: !local,
    };
  });

const totalSkills = Object.keys(catalog.skills).length + Object.values(referencedCounts).reduce((a, b) => a + b, 0);
const authors = [
  ...new Map(Object.values(manifest.sources).map((s) => [s.author, `https://github.com/${s.repo}`])),
  ["leonxlnx", "https://github.com/Leonxlnx/taste-skill"],
  ["Dietrich Gebert", "https://github.com/DietrichGebert/ponytail"],
];

const guideOrder = ["start-here", "using-skills", "catalog", "power-user", "customize", "own-server"];
const guides = (await getCollection("docs"))
  .filter((g) => guideOrder.includes(g.id))
  .sort((a, b) => guideOrder.indexOf(a.id) - guideOrder.indexOf(b.id));

const install = [
  "/plugin marketplace add iatee/claude-skills",
  "/plugin install all@iatee-skills",
  "/reload-plugins",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Claude Skills</title>
    <meta name="description" content="A curated set of Claude Code skills, credited to their authors, plus a suggester that tells you when one fits." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="nav wrap">
      <a class="brand" href="/">
        <img src="/favicon.svg" alt="" width="26" height="26" />
        <span>Claude Skills</span>
      </a>
      <nav>
        <a href="/start-here/">Guides</a>
        <a href="/catalog/">Catalog</a>
        <a href="https://github.com/iatee/claude-skills">GitHub</a>
      </nav>
    </header>

    <main>
      <section class="hero wrap">
        <p class="eyebrow">For Claude Code</p>
        <h1>The right skill,<br /><em>at the right moment.</em></h1>
        <p class="lede">
          A hand-picked collection of Claude Code skills, credited to the people who wrote them.
          Plus a suggester that tells you when one fits, so you never have to remember them all.
        </p>
        <div class="actions">
          <a class="button primary" href="/start-here/">Start here</a>
          <a class="button" href="/catalog/">Browse {totalSkills} skills</a>
        </div>

        <div class="install" aria-label="Install commands">
          <div class="install-head">
            <span>Install in Claude Code</span>
            <button type="button" data-copy={install.join("\n")}>Copy</button>
          </div>
          <pre><code>{install.map((line) => <span class="line"><span class="prompt">›</span>{line}</span>)}</code></pre>
        </div>
      </section>

      <section class="stats wrap" aria-label="At a glance">
        <div><strong>{totalSkills}</strong><span>skills</span></div>
        <div><strong>{plugins.length}</strong><span>plugins</span></div>
        <div><strong>{authors.length}</strong><span>credited authors</span></div>
        <div><strong>1</strong><span>command to install</span></div>
      </section>

      <section class="wrap block">
        <div class="section-head">
          <h2>What's inside</h2>
          <p>Install everything with <code>all</code>, or only the plugins you want.</p>
        </div>
        <div class="grid">
          {plugins.map((p) => (
            <article class="card">
              <div class="card-top">
                <h3><code>{p.name}</code></h3>
                {p.optIn && <span class="tag">opt-in</span>}
                {p.external && !p.optIn && <span class="tag quiet">from its author</span>}
              </div>
              <p>{p.description}</p>
              <span class="count">{p.skills} {p.skills === 1 ? "skill" : "skills"}</span>
            </article>
          ))}
        </div>
      </section>

      <section class="wrap block split">
        <div>
          <p class="eyebrow">The suggester</p>
          <h2>You describe the job.<br />It remembers the skill.</h2>
          <p>
            On every message, a tiny local script checks your request against every skill you have installed.
            When one clearly fits, Claude mentions it in a single line. When nothing fits, it stays silent and
            costs nothing.
          </p>
          <ul class="checks">
            <li>Knows every installed skill, not just these</li>
            <li>Mentions each skill once per conversation</li>
            <li>Never starts anything on its own</li>
            <li><code>/suggester off</code> whenever you want quiet</li>
          </ul>
        </div>
        <div class="terminal" aria-label="Example of a suggestion">
          <div class="terminal-bar"><span></span><span></span><span></span></div>
          <div class="terminal-body">
            <p class="you"><span class="prompt">›</span>this test keeps failing every few runs and I have no idea why</p>
            <p>That pattern usually means shared state or timing. I'll reproduce it first with a loop that runs the test until it fails, then narrow it down from there.</p>
            <p class="tip">💡 <code>/coding:diagnosing-bugs</code> could help here: it pins a flaky bug down with one failing command before fixing it.</p>
          </div>
        </div>
      </section>

      <section class="wrap block">
        <div class="section-head">
          <h2>Guides</h2>
          <p>From your first session to running Claude on your own server.</p>
        </div>
        <ol class="guides">
          {guides.map((g, i) => (
            <li>
              <a href={`/${g.id}/`}>
                <span class="num">{String(i + 1).padStart(2, "0")}</span>
                <span class="text">
                  <strong>{g.data.title}</strong>
                  <span>{g.data.description}</span>
                </span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section class="wrap block credits">
        <h2>Made by others, collected with credit</h2>
        <p>
          Most skills here were written by other people and are shared under their open-source licenses.
          Each one keeps its license, and the collection links back to the original.
        </p>
        <ul>
          {authors.map(([name, url]) => <li><a href={url}>{name}</a></li>)}
        </ul>
      </section>
    </main>

    <footer class="wrap footer">
      <span>Claude Skills · MIT, with third-party skills under their own licenses</span>
      <a href="https://github.com/iatee/claude-skills">github.com/iatee/claude-skills</a>
    </footer>

    <script>
      for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
        button.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? "");
            button.textContent = "Copied";
          } catch {
            button.textContent = "Select and copy";
          }
          setTimeout(() => (button.textContent = "Copy"), 1800);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #faf8f5;
    --surface: #ffffff;
    --surface-2: #f3efe9;
    --text: #1c1917;
    --muted: #6b645c;
    --line: #e7e1d8;
    --accent: #c2410c;
    --accent-soft: #fde7da;
    --code-bg: #1c1917;
    --code-text: #f5f0e8;
    --radius: 14px;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #12110f;
      --surface: #1a1816;
      --surface-2: #211e1b;
      --text: #f2ede6;
      --muted: #a39b91;
      --line: #2e2a26;
      --accent: #f07a45;
      --accent-soft: #3b1a0c;
      --code-bg: #0b0a09;
      --code-text: #f2ede6;
      color-scheme: dark;
    }
  }

  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 400 17px/1.6 "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; }
  code { font-family: "JetBrains Mono", ui-monospace, Menlo, monospace; font-size: 0.88em; }

  .wrap { width: min(1120px, 100% - 32px); margin-inline: auto; }

  .nav { display: flex; align-items: center; justify-content: space-between; padding: 22px 0; }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 600; text-decoration: none; }
  .nav nav { display: flex; gap: 24px; font-size: 15px; }
  .nav nav a { color: var(--muted); text-decoration: none; }
  .nav nav a:hover { color: var(--text); }

  .hero { padding: 72px 0 48px; }
  .eyebrow {
    margin: 0 0 14px;
    color: var(--accent);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1, h2 { font-family: "Instrument Serif", Georgia, serif; font-weight: 400; letter-spacing: -0.01em; }
  h1 { margin: 0; font-size: clamp(44px, 8vw, 88px); line-height: 1; }
  h1 em { color: var(--accent); }
  .lede { max-width: 620px; margin: 28px 0 0; color: var(--muted); font-size: 19px; }

  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .button {
    display: inline-flex;
    align-items: center;
    padding: 11px 20px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }
  .button:hover { border-color: var(--muted); transform: translateY(-1px); }
  .button.primary { background: var(--text); border-color: var(--text); color: var(--bg); }

  .install {
    max-width: 620px;
    margin-top: 44px;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--code-bg);
    color: var(--code-text);
    box-shadow: 0 20px 50px -30px rgba(28, 25, 23, 0.6);
  }
  .install-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 13px;
    color: rgba(245, 240, 232, 0.6);
  }
  .install-head button {
    padding: 4px 12px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .install-head button:hover { color: var(--code-text); border-color: rgba(255, 255, 255, 0.35); }
  .install pre { margin: 0; padding: 18px 20px; overflow-x: auto; font-size: 15px; line-height: 1.9; }
  .install .line { display: block; white-space: pre; }
  .prompt { color: var(--accent); margin-right: 12px; user-select: none; }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-block: 1px solid var(--line);
  }
  .stats div { display: flex; flex-direction: column; padding: 24px 0; }
  .stats strong { font-family: "Instrument Serif", Georgia, serif; font-size: 44px; font-weight: 400; line-height: 1; }
  .stats span { color: var(--muted); font-size: 14px; margin-top: 6px; }

  .block { padding: 88px 0 0; }
  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 24px; margin-bottom: 28px; }
  .section-head h2, .split h2, .credits h2 { margin: 0; font-size: clamp(34px, 5vw, 48px); line-height: 1.05; }
  .section-head p { margin: 0; color: var(--muted); }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .card {
    display: flex;
    flex-direction: column;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .card-top { display: flex; align-items: center; gap: 10px; }
  .card h3 { margin: 0; font-size: 17px; font-weight: 600; }
  .card h3 code { font-size: 16px; }
  .card p { flex: 1; margin: 10px 0 18px; color: var(--muted); font-size: 15px; line-height: 1.55; }
  .count { color: var(--muted); font-size: 13px; }
  .tag {
    padding: 2px 9px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 12px;
    font-weight: 500;
  }
  .tag.quiet { background: var(--surface-2); color: var(--muted); }

  .split { display: grid; grid-template-columns: 1fr 1.1fr; gap: 56px; align-items: center; }
  .split > div > p { color: var(--muted); }
  .checks { margin: 24px 0 0; padding: 0; list-style: none; }
  .checks li { position: relative; padding: 6px 0 6px 28px; }
  .checks li::before { content: "✓"; position: absolute; left: 0; color: var(--accent); font-weight: 600; }

  .terminal { overflow: hidden; border-radius: var(--radius); background: var(--code-bg); color: var(--code-text); }
  .terminal-bar { display: flex; gap: 7px; padding: 14px 16px; }
  .terminal-bar span { width: 11px; height: 11px; border-radius: 50%; background: rgba(255, 255, 255, 0.14); }
  .terminal-body { padding: 4px 22px 22px; font-size: 15px; }
  .terminal-body p { margin: 0 0 14px; color: rgba(245, 240, 232, 0.78); }
  .terminal-body .you { color: var(--code-text); font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 14px; }
  .terminal-body .tip {
    margin: 0;
    padding: 12px 14px;
    border-left: 2px solid var(--accent);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--code-text);
  }

  .guides { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .guides a {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 22px 4px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: background 0.15s;
  }
  .guides a:hover { background: var(--surface-2); }
  .guides .num { color: var(--muted); font-family: "JetBrains Mono", monospace; font-size: 14px; }
  .guides .text { display: flex; flex-direction: column; gap: 2px; }
  .guides .text span { color: var(--muted); font-size: 15px; }
  .guides .arrow { color: var(--muted); transition: transform 0.15s; }
  .guides a:hover .arrow { color: var(--accent); transform: translateX(3px); }

  .credits > p { max-width: 620px; color: var(--muted); }
  .credits ul { display: flex; flex-wrap: wrap; gap: 10px; margin: 24px 0 0; padding: 0; list-style: none; }
  .credits li a {
    display: inline-block;
    padding: 8px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 15px;
    text-decoration: none;
  }
  .credits li a:hover { border-color: var(--accent); color: var(--accent); }

  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 96px;
    padding: 28px 0 40px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 14px;
  }

  a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  @media (max-width: 820px) {
    .hero { padding-top: 40px; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .split { grid-template-columns: 1fr; gap: 36px; }
    .grid { grid-template-columns: repeat(2, 1fr); }
    .nav nav { gap: 16px; }
  }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    body { font-size: 16px; }
    .install pre { font-size: 13px; }
    .guides a { grid-template-columns: 36px 1fr; }
    .guides .arrow { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }
</style>
