{
  "$comment": "Moments worth a checklist, checked in this order. When a prompt contains one of the `when` phrases (any language, any case) and the session matches `context` (an optional regex over the transcript and prompt), Claude suggests up to four of the listed skills that are installed and not yet used, once per session. Each skill is a plugin:skill id or a plain name, or a list of alternatives where the first installed one wins. Claude Code's built-in skills are listed in builtins.json. A moment's optional `covers` lists moments it stands in for, which then stay quiet. Add your own moments in ~/.claude/skill-suggester/settings.json under \"milestones\".",
  "release": {
    "when": [
      "cut a release", "make a release", "new release", "tag a version", "tag a release", "release it", "publish to npm", "publish the package",
      "sacar una nueva versión", "crear un release", "publicar en npm",
      "release erstellen", "neue version veröffentlichen", "auf npm veröffentlichen", "version taggen",
      "faire une release", "sortir une nouvelle version", "publier sur npm",
      "lançar uma nova versão", "criar um release", "publicar no npm"
    ],
    "message": "the user is about to release a new version. A checklist and a review first avoid a broken release",
    "before": "release",
    "skills": ["deploy-checklist", ["coding:code-review", "code-review"], "security-review", "documentation"]
  },
  "publish-site": {
