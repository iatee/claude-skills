      "veröffentlichen", "veröffentliche", "deployen", "live schalten", "online stellen", "die seite ist fertig", "die website ist fertig",
      "publier", "publie", "déployer", "déploie", "mettre en ligne", "mise en ligne", "le site est prêt", "le site est fini",
      "implantar", "colocar no ar", "o site está pronto"
    ],
    "context": "\\.(html|css|scss|astro|jsx|tsx|vue|svelte)\\b",
    "message": "the user is about to publish a website. Before it goes live, they should check the design language, security, SEO and accessibility",
    "before": "publish",
    "skills": ["impeccable", ["security:vibe-security", "vibe-security"], ["searchfit-seo:seo-audit", "seo-audit"], "accessibility-review", ["searchfit-seo:ai-visibility", "seo-ai-visibility", "ai-visibility"]],
